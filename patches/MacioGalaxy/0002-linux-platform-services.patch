 #include <algorithm>
@@ -130,6 +141,85 @@ struct MainSymbols {
 };
 std::atomic<MainSymbols*> gMainSymbols{nullptr};
 
+#if !defined(__APPLE__)
+// Linux: the same table from the ELF symbol table of /proc/self/exe (mapped read-only and kept mapped, because the
+// names point into it). Function and object symbols with a size, plus the load bias of the main program (PIE).
+// The binary must keep .symtab (do not strip it: scripts/package_portmaster.sh keeps it); without it the table is
+// empty and lookups fall back to dladdr, as on macOS before the table is built.
+MainSymbols* buildMainSymbols() {
+    auto* table = new MainSymbols;
+    const int fd = ::open("/proc/self/exe", O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        return table;
+    }
+    struct stat st {};
+    if (::fstat(fd, &st) != 0 || st.st_size < static_cast<off_t>(sizeof(ElfW(Ehdr)))) {
+        ::close(fd);
+        return table;
+    }
+    void* map = ::mmap(nullptr, static_cast<std::size_t>(st.st_size), PROT_READ, MAP_PRIVATE, fd, 0);
+    ::close(fd);
+    if (map == MAP_FAILED) {
+        return table;
+    }
+    const auto* base = static_cast<const unsigned char*>(map);
+    const auto* eh = reinterpret_cast<const ElfW(Ehdr)*>(base);
+    if (std::memcmp(eh->e_ident, ELFMAG, SELFMAG) != 0 || eh->e_shoff == 0) {
+        return table;
+    }
+    std::uintptr_t bias = 0;
+    dl_iterate_phdr([](dl_phdr_info* info, std::size_t, void* data) -> int {
+        *static_cast<std::uintptr_t*>(data) = info->dlpi_addr;  // the first object is the main program
+        return 1;
+    }, &bias);
+    const auto* sections = reinterpret_cast<const ElfW(Shdr)*>(base + eh->e_shoff);
+    std::vector<std::pair<std::uint64_t, const char*>> entries;
+    std::uint64_t low = UINT64_MAX, high = 0;
+    for (int i = 0; i < eh->e_shnum; ++i) {
+        const ElfW(Shdr)& sh = sections[i];
+        if ((sh.sh_flags & SHF_EXECINSTR) != 0 && sh.sh_addr != 0) {
+            low = std::min<std::uint64_t>(low, sh.sh_addr + bias);
+            high = std::max<std::uint64_t>(high, sh.sh_addr + sh.sh_size + bias);
+        }
+        if (sh.sh_type != SHT_SYMTAB || sh.sh_link >= eh->e_shnum) {
+            continue;
+        }
+        const char* strings = reinterpret_cast<const char*>(base + sections[sh.sh_link].sh_offset);
+        const auto* symbols = reinterpret_cast<const ElfW(Sym)*>(base + sh.sh_offset);
+        const std::size_t count = sh.sh_size / sizeof(ElfW(Sym));
+        for (std::size_t s = 0; s < count; ++s) {
+            const ElfW(Sym)& symbol = symbols[s];
+            const int type = ELF64_ST_TYPE(symbol.st_info);
+            if (symbol.st_shndx == SHN_UNDEF || symbol.st_name == 0 || (type != STT_FUNC && type != STT_OBJECT)) {
+                continue;
+            }
+            const char* name = strings + symbol.st_name;
+            if (name[0] == '\0' || name[0] == '$' || std::strncmp(name, ".L", 2) == 0) {
+                continue;  // mapping symbols ($x/$d on aarch64) and assembler-local labels
+            }
+            entries.emplace_back(symbol.st_value + bias, name);
+        }
+    }
+    if (entries.empty() || high <= low) {
+        return table;
+    }
+    table->low = low;
+    table->high = high;
+    std::stable_sort(entries.begin(), entries.end(),
+                     [](const auto& a, const auto& b) { return a.first < b.first; });
+    table->addresses.reserve(entries.size());
+    table->names.reserve(entries.size());
+    for (const auto& [address, name] : entries) {
+        table->addresses.push_back(address);
+        table->names.push_back(name);
+    }
+    table->reduced.reset(new std::atomic<const std::string*>[entries.size()]);
+    for (std::size_t i = 0; i < entries.size(); ++i) {
+        table->reduced[i].store(nullptr, std::memory_order_relaxed);
+    }
+    return table;
+}
