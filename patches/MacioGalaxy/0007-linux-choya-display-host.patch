diff --git a/native/app/platform_host.cpp b/native/app/platform_host.cpp
index ee191a2..6466803 100644
--- a/native/app/platform_host.cpp
+++ b/native/app/platform_host.cpp
@@ -35,12 +35,20 @@ namespace Platform = PetariNative::Platform;
 
 namespace {
 
+// galaxy-choya-native: el hilo de pantalla de Choya suelta el contexto GLES y la superficie (fbdev/KMS) antes de
+// _Exit, para que el lanzador recupere la pantalla.
+extern "C" void galaxy_choya_host_stop() __attribute__((weak));
+void stopChoyaDisplay() {
+    if (galaxy_choya_host_stop != nullptr) galaxy_choya_host_stop();
+}
+
 // The OS exit functions (OSShutdownSystem, OSReturnToMenu, OSRestart, ...)
 // end here after the game's shutdown functions ran, on the game thread that
 // called them. NAND data is durable once NANDClose/NANDSafeClose returned, so
 // nothing needs flushing but stdio; process exit releases the audio device and
 // the window, so no platform shutdowns (which join their threads) run here.
 void leave(const Platform::Power::Exit& exit, void*) {
+    stopChoyaDisplay();
     Seam::reportFrameStats();
     petari_platform_report_diagnostics();
     std::fflush(stdout);
@@ -148,6 +156,7 @@ void requestQuit() {
 }
 
 void forceQuit() {
+    stopChoyaDisplay();
     Seam::reportFrameStats();
     petari_platform_report_diagnostics();
     std::fputs("Petari: quitting immediately\n", stderr);
diff --git a/native/gx/efb_snapshot.cpp b/native/gx/efb_snapshot.cpp
index 459d65d..6557fed 100644
--- a/native/gx/efb_snapshot.cpp
+++ b/native/gx/efb_snapshot.cpp
@@ -339,16 +339,26 @@ bool snapshotStats(std::uint64_t ticket, SnapshotStats& result) {
 }
 }
 
+// galaxy-choya-native: con el motor de Choya las instantáneas las lee el núcleo GLES (galaxy_choya_bridge.cpp); el
+// backend nulo de WebGPU no tiene píxeles reales.
+extern "C" bool galaxy_choya_presents() __attribute__((weak));
+extern "C" bool galaxy_choya_read_snapshot(std::uint64_t, std::uint16_t, std::uint16_t, std::uint32_t*,
+                                           std::uint32_t*) __attribute__((weak));
+extern "C" void galaxy_choya_retire_snapshots(std::uint64_t) __attribute__((weak));
+static bool choyaSnapshots() { return galaxy_choya_presents != nullptr && galaxy_choya_presents(); }
+
 extern "C" void petari_gx_install_snapshots() {
     petari_gx_sync_set_snapshot_hook([](std::uint64_t ticket, std::uint16_t,
                                        std::uint64_t, void*) {
-        PetariNative::GX::retireSnapshots(petari_gx_sync_delivered_ticket());
+        if (choyaSnapshots()) galaxy_choya_retire_snapshots(petari_gx_sync_delivered_ticket());
+        else PetariNative::GX::retireSnapshots(petari_gx_sync_delivered_ticket());
         PetariNative::GX::captureEfb(ticket, petari_gx_sync_snapshot_ready);
     }, nullptr);
 }
 
 extern "C" bool petari_gx_read_snapshot(std::uint64_t ticket, std::uint16_t x,
     std::uint16_t y, std::uint32_t* depth, std::uint32_t* argb) {
+    if (choyaSnapshots()) return galaxy_choya_read_snapshot(ticket, x, y, depth, argb);
     return PetariNative::GX::readSnapshot(ticket, x, y, *depth, *argb);
 }
 
